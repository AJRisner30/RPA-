rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // ----------------------------------------------------
    // Hardened Global Helpers
    // ----------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'risneraryan@gmail.com';
    }

    // RBAC Tier Helper: verifies Pro access with active subscription or unexpired trial
    function isTrialActive() {
      return 'trialEnd' in request.auth.token &&
        request.auth.token.trialEnd is number &&
        (
          (request.auth.token.trialEnd < 10000000000 && request.time.toMillis() < request.auth.token.trialEnd * 1000) ||
          (request.auth.token.trialEnd >= 10000000000 && request.time.toMillis() < request.auth.token.trialEnd)
        );
    }

    function hasActiveProAccess() {
      return isSignedIn() &&
        (request.auth.token.tier == 'pro' || request.auth.token.tier == 'enterprise') &&
        (
          request.auth.token.status == 'active_subscriber' ||
          isTrialActive()
        );
    }

    // Diagnostics / Connection verification
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // ----------------------------------------------------
    // Athlete Profiles
    // ----------------------------------------------------
    function isValidAthlete(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'email', 'experienceLevel', 'primaryGoal']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && (data.userId == request.auth.uid || isAdmin()) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() <= 150 &&
        data.experienceLevel in ['Beginner', 'Intermediate', 'Advanced', 'Elite'] &&
        data.primaryGoal in ['Hybrid Athlete', 'Strength & Power', 'Hypertrophy', 'Tactical & Rucking', 'Tactical Conditioning & Pursuit', 'Endurance & Running'] &&
        (!('weightLbs' in data) || data.weightLbs == null || (data.weightLbs is number && data.weightLbs >= 0 && data.weightLbs <= 1000)) &&
        (!('restingHr' in data) || data.restingHr == null || (data.restingHr is number && data.restingHr >= 20 && data.restingHr <= 250)) &&
        (!('maxHr' in data) || data.maxHr == null || (data.maxHr is number && data.maxHr >= 50 && data.maxHr <= 260)) &&
        (!('avatarColor' in data) || data.avatarColor == null || (data.avatarColor is string && data.avatarColor.size() <= 80)) &&
        (!('joinedDate' in data) || data.joinedDate == null || (data.joinedDate is string && data.joinedDate.size() <= 60)) &&
        (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 3000)) &&
        (!('questionnaire' in data) || data.questionnaire == null || data.questionnaire is map) &&
        (!('weightHistory' in data) || data.weightHistory == null || data.weightHistory is list) &&
        (!('recoveryHistory' in data) || data.recoveryHistory == null || data.recoveryHistory is list) &&
        (!('lastRecoveryCheckIn' in data) || data.lastRecoveryCheckIn == null || data.lastRecoveryCheckIn is map) &&
        (!('subscription' in data) || data.subscription == null || data.subscription is map) &&
        (!('trialActivation' in data) || data.trialActivation == null || data.trialActivation is map) &&
        (!('trialState' in data) || data.trialState == null || data.trialState is map) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /athletes/{athleteId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(athleteId) && isValidAthlete(incoming());
      allow update: if isSignedIn() && isValidId(athleteId) &&
        isValidAthlete(incoming()) &&
        (!('userId' in existing()) || existing().userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(athleteId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // ----------------------------------------------------
    // Workout Session Logs
    // ----------------------------------------------------
    function isValidWorkoutLog(data) {
      return data.keys().hasAll(['id', 'userId', 'workoutTitle', 'date', 'durationMinutes', 'totalVolumeLbs', 'totalSetsCompleted']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.workoutTitle is string && data.workoutTitle.size() > 0 && data.workoutTitle.size() <= 200 &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 50 &&
        data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 10000 &&
        data.totalVolumeLbs is number && data.totalVolumeLbs >= 0 && data.totalVolumeLbs <= 5000000 &&
        data.totalSetsCompleted is number && data.totalSetsCompleted >= 0 && data.totalSetsCompleted <= 1000 &&
        (!('athleteId' in data) || data.athleteId == null || (data.athleteId is string && data.athleteId.size() <= 128)) &&
        (!('athleteName' in data) || data.athleteName == null || (data.athleteName is string && data.athleteName.size() <= 150)) &&
        (!('userEmail' in data) || data.userEmail == null || (data.userEmail is string && data.userEmail.size() <= 150)) &&
        (!('isCoachLog' in data) || data.isCoachLog == null || (data.isCoachLog is bool)) &&
        (!('programId' in data) || data.programId == null || (data.programId is string && data.programId.size() <= 128)) &&
        (!('startTime' in data) || data.startTime == null || (data.startTime is string && data.startTime.size() <= 100)) &&
        (!('endTime' in data) || data.endTime == null || (data.endTime is string && data.endTime.size() <= 100)) &&
        (!('rating' in data) || data.rating == null || (data.rating is number && data.rating >= 0 && data.rating <= 10)) &&
        (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 5000)) &&
        (!('exercises' in data) || data.exercises == null || (data.exercises is list && data.exercises.size() <= 100)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isCoachWorkoutLog(data) {
      return ('isCoachLog' in data && data.isCoachLog == true) ||
        ('userEmail' in data && data.userEmail == 'risneraryan@gmail.com') ||
        ('athleteId' in data && data.athleteId == 'athlete-aj-risner');
    }

    match /workoutLogs/{logId} {
      // Coach Aryan Risner's workout logs are open for every other user to inspect and train along with
      allow get: if isCoachWorkoutLog(resource.data) || (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()));
      allow list: if isCoachWorkoutLog(resource.data) || (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()));
      allow create: if isSignedIn() && isValidId(logId) && isValidWorkoutLog(incoming());
      allow update: if isSignedIn() && isValidId(logId) &&
        isValidWorkoutLog(incoming()) &&
        (incoming().userId == request.auth.uid || existing().userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(logId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // ----------------------------------------------------
    // Custom Workout Programs
    // ----------------------------------------------------
    function isValidCustomProgram(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'category', 'exercises']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.category is string && data.category.size() <= 80 &&
        data.exercises is list && data.exercises.size() <= 100 &&
        (!('schedule' in data) || data.schedule == null || data.schedule is list) &&
        (!('subtitle' in data) || data.subtitle == null || (data.subtitle is string && data.subtitle.size() <= 300)) &&
        (!('frequency' in data) || data.frequency == null || (data.frequency is string && data.frequency.size() <= 100)) &&
        (!('estimatedDurationMinutes' in data) || data.estimatedDurationMinutes == null || (data.estimatedDurationMinutes is number && data.estimatedDurationMinutes >= 0 && data.estimatedDurationMinutes <= 1000)) &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 5000)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /customPrograms/{programId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(programId) && isValidCustomProgram(incoming());
      allow update: if isSignedIn() && isValidId(programId) &&
        isValidCustomProgram(incoming()) &&
        (!('userId' in existing()) || existing().userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(programId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // ----------------------------------------------------
    // Rucking Progression Logs
    // ----------------------------------------------------
    function isValidRuckLog(data) {
      return data.keys().hasAll(['id', 'userId', 'date', 'distanceMiles', 'weightLbs', 'durationMinutes']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 50 &&
        data.distanceMiles is number && data.distanceMiles >= 0 && data.distanceMiles <= 500 &&
        data.weightLbs is number && data.weightLbs >= 0 && data.weightLbs <= 500 &&
        data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 5000 &&
        (!('title' in data) || data.title == null || (data.title is string && data.title.size() <= 200)) &&
        (!('athleteId' in data) || data.athleteId == null || (data.athleteId is string && data.athleteId.size() <= 128)) &&
        (!('paceMinPerMile' in data) || data.paceMinPerMile == null || (data.paceMinPerMile is number && data.paceMinPerMile >= 0 && data.paceMinPerMile <= 300)) &&
        (!('workloadIndex' in data) || data.workloadIndex == null || (data.workloadIndex is number && data.workloadIndex >= 0 && data.workloadIndex <= 100000)) &&
        (!('terrain' in data) || data.terrain == null || (data.terrain is string && data.terrain.size() <= 100)) &&
        (!('heartRateAvg' in data) || data.heartRateAvg == null || (data.heartRateAvg is number && data.heartRateAvg >= 20 && data.heartRateAvg <= 300)) &&
        (!('rpe' in data) || data.rpe == null || (data.rpe is number && data.rpe >= 0 && data.rpe <= 10)) &&
        (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 3000)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /ruckLogs/{ruckId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(ruckId) && isValidRuckLog(incoming());
      allow update: if isSignedIn() && isValidId(ruckId) &&
        isValidRuckLog(incoming()) &&
        (!('userId' in existing()) || existing().userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(ruckId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // ----------------------------------------------------
    // Individual Officer Specific Programs
    // Confidential portal programs assigned specifically to one officer account
    // Access: ONLY the targeted officer (resource.data.officerUserId == request.auth.uid) OR Admin can read.
    // Writes: ONLY Admin can create/update/delete individual officer assigned programs.
    // ----------------------------------------------------
    function isValidOfficerProgram(data) {
      return data.keys().hasAll(['id', 'officerUserId', 'programTitle', 'category']) &&
        data.id is string && isValidId(data.id) &&
        data.officerUserId is string && data.officerUserId.size() > 0 && data.officerUserId.size() <= 128 &&
        data.programTitle is string && data.programTitle.size() > 0 && data.programTitle.size() <= 150 &&
        data.category is string && data.category.size() <= 60 &&
        (!('programSubtitle' in data) || (data.programSubtitle is string && data.programSubtitle.size() <= 250)) &&
        (!('officerEmail' in data) || (data.officerEmail is string && data.officerEmail.size() <= 150)) &&
        (!('officerName' in data) || (data.officerName is string && data.officerName.size() <= 100)) &&
        (!('badgeNumber' in data) || (data.badgeNumber is string && data.badgeNumber.size() <= 40)) &&
        (!('department' in data) || (data.department is string && data.department.size() <= 120)) &&
        (!('coachNotes' in data) || (data.coachNotes is string && data.coachNotes.size() <= 3000)) &&
        (!('frequency' in data) || (data.frequency is string && data.frequency.size() <= 80)) &&
        (!('estimatedDurationMinutes' in data) || (data.estimatedDurationMinutes is number && data.estimatedDurationMinutes >= 0 && data.estimatedDurationMinutes <= 360)) &&
        (!('scheduleDays' in data) || (data.scheduleDays is list && data.scheduleDays.size() <= 14)) &&
        (!('exercises' in data) || (data.exercises is list && data.exercises.size() <= 50)) &&
        (!('assignedByEmail' in data) || (data.assignedByEmail is string && data.assignedByEmail.size() <= 150)) &&
        (!('assignedAt' in data) || (data.assignedAt is string && data.assignedAt.size() <= 60)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    match /officerPrograms/{programId} {
      allow get: if isSignedIn() && (resource.data.officerUserId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.officerUserId == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidId(programId) && isValidOfficerProgram(incoming());
      allow update: if isAdmin() && isValidId(programId) && isValidOfficerProgram(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(programId);
    }

    // ----------------------------------------------------
    // Shared Coach Custom Programs & Single Workouts
    // Reads: Any signed-in athlete can view published programs; Admin can view all (including drafts).
    // Writes: Strictly Coach AJ (isAdmin()) only.
    // ----------------------------------------------------
    function isValidCoachProgram(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'exercises', 'isPublished', 'createdByEmail']) &&
        data.id is string && isValidId(data.id) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.category is string && data.category.size() <= 80 &&
        data.exercises is list && data.exercises.size() <= 100 &&
        data.isPublished is bool &&
        data.createdByEmail is string && data.createdByEmail == 'risneraryan@gmail.com' &&
        (!('programKind' in data) || data.programKind == null || data.programKind in ['program', 'single_workout']) &&
        (!('isCoachPublished' in data) || data.isCoachPublished == null || data.isCoachPublished is bool) &&
        (!('allowAiAdaptation' in data) || data.allowAiAdaptation == null || data.allowAiAdaptation is bool) &&
        (!('subtitle' in data) || data.subtitle == null || (data.subtitle is string && data.subtitle.size() <= 300)) &&
        (!('frequency' in data) || data.frequency == null || (data.frequency is string && data.frequency.size() <= 100)) &&
        (!('estimatedDurationMinutes' in data) || data.estimatedDurationMinutes == null || (data.estimatedDurationMinutes is number && data.estimatedDurationMinutes >= 0 && data.estimatedDurationMinutes <= 1000)) &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 5000)) &&
        (!('schedule' in data) || data.schedule == null || (data.schedule is list && data.schedule.size() <= 100)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /coachPrograms/{programId} {
      allow get, list: if isSignedIn() && (resource.data.isPublished == true || isAdmin());
      allow create: if isAdmin() && isValidId(programId) && isValidCoachProgram(incoming());
      allow update: if isAdmin() && isValidId(programId) && isValidCoachProgram(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(programId);
    }

    // ----------------------------------------------------
    // Performance Metrics (Protected Collection)
    // Read/write access granted if user has tier: "pro" AND either:
    // status is "active_subscriber" OR request.time < trialEnd timestamp
    // ----------------------------------------------------
    match /performance_metrics/{metricId} {
      allow read, write: if hasActiveProAccess();
    }

    // ----------------------------------------------------
    // System & Payment Configuration (Square Links)
    // ----------------------------------------------------
    match /settings/{settingId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /square_config/{configId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /trial_codes/{codeId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // ----------------------------------------------------
    // Admin Directory
    // ----------------------------------------------------
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
